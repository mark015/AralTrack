# Only the public/ folder is served. Everything else (config, src, vendor, database)
# is unreachable from the browser.
Options -Indexes

# Installable app (PWA) manifest
<IfModule mod_mime.c>
    AddType application/manifest+json .webmanifest
</IfModule>

# The service worker must never be kept by the browser or the hosting's CDN, or phones keep an old version
# (without phone alerts, for example) for days after an update.
<IfModule mod_headers.c>
    <FilesMatch "^sw\.js$">
        Header set Cache-Control "no-cache, max-age=0"
    </FilesMatch>
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^((?!public/).*)$ public/$1 [L]
</IfModule>

<IfModule !mod_rewrite.c>
    Require all denied
</IfModule>
